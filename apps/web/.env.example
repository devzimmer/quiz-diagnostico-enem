# Base da API. Vazio em dev: o Vite faz proxy de /api para o Worker local (porta 8787).
VITE_API_URL=

# Login do painel (Supabase Auth). Escolha um dos modos:
# 1) Supabase local (Docker): valores de `pnpm db:status` (API URL e anon/publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# 2) Sem Docker: `pnpm --filter @quiz/api dev:memory` imita o Auth na própria porta da API.
# VITE_SUPABASE_URL=http://127.0.0.1:8787
# VITE_SUPABASE_ANON_KEY=dev-memory
